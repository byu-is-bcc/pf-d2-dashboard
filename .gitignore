# Secrets. A real secret in git HISTORY is an automatic fail on the
# Portfolio Factory rubric, and deleting the file later does not remove it.
.env
.env.*
!.env.example

# Model artifacts. Regenerated by `python train.py`, which is why the
# dataset is committed and the artifact is not.
#
# A binary pickle in git is a bad default: it is unreadable in a diff, it
# grows the repository every retrain, and it silently pins you to the
# scikit-learn version that wrote it. Commit the code and the data that
# produce the artifact instead.
models/*.joblib
models/*.pkl

# Latency measurements, if you write them to a file. Commit the number in
# your README and the script that produced it, not the raw run.
latency*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Notebooks, if you add one for exploration
.ipynb_checkpoints/

# OS and editor
.DS_Store
.vscode/
.idea/
