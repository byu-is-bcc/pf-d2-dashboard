# Copy to .env for local overrides. Never commit .env itself.
#
#   cp .env.example .env
#
# Everything here has a working default, so the service runs with no .env
# at all. That is deliberate: a starter that requires configuration before
# it will start is a starter nobody finishes.

# Port the service binds to. Railway, Render, and Fly all inject this, so
# do not hardcode 8000 in your start command.
# PORT=8000

# Where the serialized artifact lives. Change this if you write the model
# somewhere other than models/model.joblib.
# MODEL_PATH=models/model.joblib

# --- Persistence, if you log predictions -----------------------------------
# The brief allows SQLite or Supabase. SQLite needs no configuration and is
# the right answer until you have a reason for otherwise.
#
# DATABASE_URL=sqlite:///predictions.db
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=

# Leave the two lines above empty here and set the real values in your
# platform's environment variable settings. If a key ever lands in this
# file, rotate it. It is committed.
